# --- Telegram alerts (leave blank for console-only mode) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polling ---
POLL_INTERVAL=120          # seconds between checks
REQUEST_TIMEOUT=15         # HTTP timeout per request

# --- Exchanges ---
ENABLE_GATE=true
ENABLE_BINANCE=true

# --- Behaviour ---
# Alert on existing matches during the very first cycle. Default false so the
# first run only records a baseline instead of alerting on every listed pair.
ALERT_ON_FIRST_RUN=false

# Comma-separated extra equity tickers to treat as stock tokens, e.g. RBLX,RIVN
EXTRA_TICKERS=

# Where to persist the set of already-seen pairs.
STATE_FILE=seen_symbols.json
